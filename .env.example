CQA_PROVIDER=groq
CQA_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
CQA_OLLAMA_URL=http://127.0.0.1:11434
# Set CQA_PROVIDER=groq and CQA_MODEL=openai/gpt-oss-120b for Groq.
CQA_DATASET_URL=
CQA_DATASET_GROUP_ID=DEV
CQA_AUTO_IMPORT=true
CQA_TEAM_NAME=team vasya
CQA_TIMEOUT=300
CQA_MAX_ATTEMPTS=3
CQA_MAX_OUTPUT_TOKENS=2500
CQA_OLLAMA_CONTEXT=32768
# Minimum spacing between model requests, not a guarantee of quota sufficiency.
CQA_REQUEST_INTERVAL=60
# Optional rolling 24-hour token guard; 0 disables. Reserve quota for PROD.
CQA_TOKEN_BUDGET=160000
# Keep true until a human-reviewed multilingual quality check is complete.
CQA_REQUIRE_REVIEW=true
# auto = focused criterion requests for local Ollama; single request for Groq.
CQA_EVALUATION_STRATEGY=auto
